{
  "name": "go7-workhorse",
  "productName": "Go7 Workhorse",
  "version": "0.1.9",
  "private": true,
  "description": "One desk for every AI subscription you already pay for: Grok, Claude, Codex, Cursor and your own API keys, each under its own login, on Windows and macOS.",
  "keywords": [
    "ai",
    "ai-agents",
    "desktop",
    "electron",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "grok",
    "llm",
    "multi-model",
    "model-routing",
    "agent-orchestration",
    "subscriptions",
    "openai-compatible",
    "anthropic-compatible",
    "developer-tools"
  ],
  "author": "Go7 Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/go7studio/Go7-Workhorse.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run eval:validate && tsc -p tsconfig.json --noEmit && vite build",
    "verify": "npm run build && npm test",
    "eval:validate": "node scripts/workhorse-eval.mjs validate",
    "eval:list": "node scripts/workhorse-eval.mjs list",
    "eval:init": "node scripts/workhorse-eval.mjs init",
    "eval:preflight": "tsx scripts/workhorse-eval-preflight.ts",
    "eval:smoke": "tsx test/provider-live-smoke.ts",
    "eval:capability-smoke": "tsx test/capability-live-smoke.ts",
    "eval:plan-fixture-check": "node scripts/workhorse-eval-plan-fixture.mjs",
    "eval:device-probes": "node scripts/workhorse-eval-device-probes.mjs",
    "eval:godot-suite": "node scripts/workhorse-eval-godot-suite.mjs",
    "eval:real-plan-smoke": "tsx test/real-world-plan-smoke.ts",
    "eval:fixture": "node scripts/workhorse-eval-fixture.mjs",
    "eval:fixture-check": "node scripts/workhorse-eval-fixture.mjs --self-test",
    "eval:media-fixtures": "node scripts/workhorse-eval-media-fixtures.mjs",
    "eval:score": "node scripts/workhorse-eval.mjs score",
    "eval:finalize": "node scripts/workhorse-eval.mjs finalize",
    "pack:win": "npm run build && electron-builder --win --dir",
    "package:win": "electron-builder --win nsis --publish never",
    "dist:win": "npm run build && npm run package:win",
    "pack:mac": "npm run build && electron-builder --mac --dir --arm64 --x64 --publish never",
    "package:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:mac": "npm run build && npm run package:mac",
    "preview": "vite preview",
    "test": "tsx --test test/workhorse.test.ts test/codex-adapter.test.ts test/codex-app-server.test.ts test/custom-http.test.ts test/claude-adapter.test.ts test/cursor-adapter.test.ts test/watch.test.ts test/routing.test.ts test/plan.test.ts test/attachments.test.ts test/app-update.test.ts test/session-environment.test.ts test/terminal-host.test.ts test/schedule.test.ts test/provider-contract.test.ts test/credential-store.test.ts test/mcp-tool-bridge.test.ts test/portable-compaction.test.ts test/support-surfaces.test.ts test/state-persistence.test.ts test/desk-export.test.ts test/eval-kit.test.ts test/folder-access.test.ts test/learning-memory.test.ts test/project-diff.test.ts test/vendor-meter.test.ts test/repo-shape.test.ts test/usage-metering.test.ts test/lineup-sidebar.test.ts",
    "eval:learning-smoke": "node scripts/learning-packaged-smoke.mjs",
    "probe:sqlite": "node scripts/learning-sqlite-probe.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.66.0",
    "@agentclientprotocol/codex-acp": "^1.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.go7studio.workhorse",
    "productName": "Go7 Workhorse",
    "copyright": "Copyright \u00a9 2026 Go7 Studio",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/app-icons",
        "to": "assets/app-icons"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icons/go7-workhorse.ico",
      "executableName": "Go7 Workhorse"
    },
    "nsis": {
      "artifactName": "Go7-Workhorse-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Go7 Workhorse",
      "uninstallDisplayName": "Go7 Workhorse",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icons/go7-workhorse.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Workhorse and the agents in this chat read and write the project folders you link.",
        "NSDesktopFolderUsageDescription": "Workhorse uses Desktop folders you link as a project workspace.",
        "NSDownloadsFolderUsageDescription": "Workhorse uses Downloads folders you link as a project workspace.",
        "NSRemovableVolumesUsageDescription": "Workhorse uses external disks you link as a project workspace.",
        "NSNetworkVolumesUsageDescription": "Workhorse uses network folders you link as a project workspace."
      },
      "artifactName": "Go7-Workhorse-${version}-mac-${arch}.${ext}"
    }
  }
}
