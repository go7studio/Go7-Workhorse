{
  "schemaVersion": 1,
  "suite": "go7-workhorse",
  "mode": "baseline-only",
  "source": {
    "channel": "source",
    "repository": "https://github.com/go7studio/Go7-Workhorse.git",
    "ref": "origin/main",
    "expectedVersion": "0.6.54"
  },
  "install": {
    "existingAppPath": "",
    "packagedAppPath": "",
    "freshUserDataDirectory": "",
    "preserveExistingUserData": true
  },
  "profiles": {
    "grok-acp": {
      "enabled": false,
      "notes": "Disabled by default; may be enabled for one bounded adapter smoke call."
    },
    "codex-acp": {
      "enabled": false,
      "notes": "Disabled by default; may be enabled for one bounded adapter smoke call."
    },
    "claude-acp": {
      "enabled": false,
      "notes": "Disabled by default; may be enabled for one bounded adapter smoke call."
    },
    "cursor-acp": {
      "enabled": false,
      "notes": "Disabled by default; may be enabled for one bounded authenticated Cursor ACP smoke call."
    },
    "custom-openai": {
      "enabled": true,
      "baseUrlEnv": "WORKHORSE_EVAL_MINIMAX_BASE_URL",
      "apiKeyEnv": "WORKHORSE_EVAL_MINIMAX_API_KEY",
      "model": "MiniMax-M3",
      "notes": "The only live model-call profile allowed by this variant. Use MiniMax's OpenAI-compatible endpoint, never Anthropic's API."
    },
    "custom-kimi": {
      "enabled": false,
      "baseUrlEnv": "WORKHORSE_EVAL_KIMI_BASE_URL",
      "apiKeyEnv": "WORKHORSE_EVAL_KIMI_API_KEY",
      "model": "Kimi-K3",
      "notes": "One bounded visual audit call only; no cascading agents."
    },
    "custom-anthropic": {
      "enabled": false,
      "notes": "Disabled by default; may be enabled for one bounded API-shape smoke call when required."
    }
  },
  "modelPolicy": {
    "enforce": true,
    "primaryLiveProfile": "custom-openai",
    "primaryModel": "MiniMax-M3",
    "internalToolCallingModel": "MiniMax-M3",
    "providerSmokeExceptions": {
      "profiles": [
        "grok-acp",
        "codex-acp",
        "claude-acp",
        "cursor-acp",
        "custom-kimi",
        "custom-anthropic"
      ],
      "maxCallsPerProfile": 1,
      "requireAdapterEvidence": true,
      "allowCascading": false
    },
    "cascade": {
      "profiles": [
        "custom-openai"
      ],
      "models": [
        "MiniMax-M3"
      ],
      "effort": "low",
      "maxDepth": 2,
      "maxConcurrentChildren": 2,
      "perChildTokenBudget": 10000,
      "nestedChildTokenBudget": 5000,
      "maxNestedChildrenPerWorker": 1
    },
    "notes": "MiniMax-M3 runs the eval and internal tools. Minimal provider/API or OAuth smoke calls are allowed only to prove an adapter; they may not cascade."
  },
  "externalHarnesses": {
    "liveSmokeEnabled": false,
    "targetChatEnv": "WORKHORSE_EVAL_HARNESS_TARGET_CHAT",
    "parentChatEnv": "WORKHORSE_EVAL_HARNESS_PARENT_CHAT",
    "statePathEnv": "WORKHORSE_STATE_PATH",
    "maxHarnessCalls": 1,
    "requiredWorkhorseReplies": 2,
    "requireExplicitTrace": true,
    "requireTerminalDuration": true,
    "notes": "Run OpenClaw and Hermes separately. Missing binary, login, model, target chat, or state path is not_run, never a fallback to another harness or provider."
  },
  "multiModelConnections": {
    "liveSmokeEnabled": false,
    "baseUrlEnv": "WORKHORSE_EVAL_MULTI_MODEL_BASE_URL",
    "apiKeyEnv": "WORKHORSE_EVAL_MULTI_MODEL_API_KEY",
    "modelsEnv": "WORKHORSE_EVAL_MULTI_MODEL_MODELS",
    "defaultModels": [
      "syn:large:text",
      "syn:large:vision"
    ],
    "catalogFixtures": [
      "synthetic",
      "openrouter"
    ],
    "catalogMaxGroups": 6,
    "catalogMaxModelsPerGroup": 4,
    "maxCalls": 2,
    "requireSameKey": true,
    "requireDistinctRequestedModels": true
  },
  "spend": {
    "liveApiAllowed": false,
    "approvedUsd": 0,
    "approvalTicket": ""
  },
  "safety": {
    "allowNetwork": false,
    "allowOutsideWorkspace": false,
    "allowDestructiveProductActions": false,
    "fixtureWorkspaceOnly": true
  },
  "planExecution": {
    "fixture": "eval/fixtures/plans/production-go-time.fixture.md",
    "requireApproval": true,
    "maxRootConcurrency": 2,
    "resumeCompletedTasks": false
  },
  "deviceProbes": {
    "workspace": "eval/fixtures/workspace",
    "readOnly": true,
    "allowInstall": false,
    "allowLaunch": false,
    "allowBoot": false
  },
  "evidence": {
    "screenshots": true,
    "screenRecording": false,
    "supportReport": true,
    "redactSecrets": true
  }
}
